<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gradle dependency verification metadata.
  See: https://docs.gradle.org/current/userguide/dependency_verification.html

  DATA CLASSIFICATION: INTERNAL — contains dependency coordinates and checksums only.
  No credentials, secrets, or cluster information are stored in this file.

  BOOTSTRAP STATE: This file contains structural configuration only.
  Populate the <components> section with real SHA-256 checksums by running:
    ./gradlew --write-verification-metadata sha256 dependencies

  POLICY:
    - verify-metadata: true  — verifies POM/metadata checksums in addition to JARs
    - verify-signatures: false — GPG signature verification deferred; requires keyserver access
    - Once checksums are populated, every artifact serves exactly the bytes it served when
      the checksum was recorded. A changed byte (supply-chain substitution or mutable
      artifact) causes the build to fail before any code is compiled.

  UPDATING CHECKSUMS (after a dependency version bump):
    1. Run ./gradlew --write-verification-metadata sha256 dependencies
    2. Review the diff of this file to confirm only the expected coordinates changed.
    3. Commit the updated file alongside the version bump in build.gradle.
    4. Also refresh lock files: ./gradlew dependencies --write-locks

  REMOVING A DEPENDENCY:
    Run ./gradlew --write-verification-metadata sha256 dependencies — Gradle removes
    entries for coordinates that are no longer in the dependency graph automatically.

  See README.md § Dependency Verification Metadata for full procedure.
-->
<verification-metadata
    xmlns="https://schema.gradle.org/dependency-verification"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.1.xsd">
   <configuration>
      <!-- verify-metadata: also verify POM and module metadata checksums, not just JARs -->
      <verify-metadata>true</verify-metadata>
      <!-- verify-signatures: disabled until a trusted keyserver is configured for CI -->
      <verify-signatures>false</verify-signatures>
   </configuration>
   <components>
      <!--
        Component checksums are populated by running:
          ./gradlew --write-verification-metadata sha256 dependencies

        Example entry (DO NOT EDIT MANUALLY — always regenerate):

        <component group="org.springframework.boot" name="spring-boot" version="3.4.1">
           <artifact name="spring-boot-3.4.1.jar">
              <sha256 value="..." origin="Generated by Gradle"/>
           </artifact>
        </component>

        All direct and transitive dependencies will be listed after generation.
        Until then, the build runs in LENIENT locking mode and does not fail on
        missing checksum entries. Promote to verified mode once checksums are committed.
      -->
   </components>
</verification-metadata>
