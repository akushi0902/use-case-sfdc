# dev.env.example
# Placeholder fixture values for dev-k8.sh dry-run and validation.
# ALL values here are non-functional placeholders only.
# Do NOT replace these with real credentials, real cluster names, or real URLs.
# Real values must be injected from your CI secret store or shell environment.

# Container image tag for the dev deployment (dev allows 'latest')
IMAGE_TAG=latest

# Dev datasource — placeholder JDBC URL format only
# Real value: set DB_URL in your CI/CD pipeline secrets
DB_URL=jdbc:postgresql://db.dev.example.internal:5432/sfdc_integrator_dev
DB_USER=sfdc_integrator_dev
# DB_PASSWORD must be injected from secrets — never stored in this file
DB_PASSWORD=placeholder-dev-password-not-real

# Kafka bootstrap servers for dev
KAFKA_BOOTSTRAP_SERVERS=kafka.dev.example.internal:9092

# Kubernetes namespace (matches hardcoded NAMESPACE in dev-k8.sh)
NAMESPACE=sfdc-integrator-dev

# OAuth2 identity provider settings for dev API pod
# OAUTH2_JWK_SET_URI and OAUTH2_ISSUER_URI are non-secret public endpoints
# Set at least one for the dev API pod — empty default means JWT validation is disabled
OAUTH2_JWK_SET_URI=https://auth.dev.example.internal/.well-known/jwks.json
# OAUTH2_EXPECTED_AUDIENCE identifies this service in JWT token validation
OAUTH2_EXPECTED_AUDIENCE=sfdc-integrator-dev

# Vault service base URL — non-secret endpoint for future vault integration
# Classification: NON-SECRET endpoint reference
VAULT_BASE_URL=https://vault.dev.example.internal:8200

# Internal package manager — set from CI secrets, not from this file
OPSERA_REPO_URL=https://pkg.example.internal/repository/maven-opsera/
OPSERA_REPO_USER=ci-service-account
# OPSERA_REPO_TOKEN must be injected from secrets — never stored in this file
OPSERA_REPO_TOKEN=placeholder-token-not-real
