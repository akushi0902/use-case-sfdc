# prod.env.example
# Placeholder fixture values for prod-k8.sh dry-run and validation.
# ALL values here are non-functional placeholders only.
# Do NOT replace these with real credentials, real cluster names, or real URLs.
# Real values must be injected from your CI secret store or shell environment.
#
# Production safety reminders:
#   - IMAGE_TAG must be an exact immutable release tag — 'latest' is rejected
#   - All credentials must come from a secret manager, not from this file
#   - Deployment requires an approved change ticket

# Container image tag for the production deployment (exact immutable tag required)
IMAGE_TAG=1.0.0

# Production datasource — placeholder JDBC URL format only
DB_URL=jdbc:postgresql://db.prod.example.internal:5432/sfdc_integrator_prod
DB_USER=sfdc_integrator_prod
# DB_PASSWORD must be injected from secrets — never stored in this file
DB_PASSWORD=placeholder-prod-password-not-real

# Kafka bootstrap servers for production
KAFKA_BOOTSTRAP_SERVERS=kafka.prod.example.internal:9092

# Kubernetes namespace (matches hardcoded NAMESPACE in prod-k8.sh)
NAMESPACE=sfdc-integrator-prod

# OAuth2 identity provider settings for production API pod
# OAUTH2_JWK_SET_URI is a non-secret public endpoint — inject from Kubernetes ConfigMap
# REQUIRED for production: JWT token validation fails silently without this value
OAUTH2_JWK_SET_URI=https://auth.prod.example.internal/.well-known/jwks.json
# OAUTH2_EXPECTED_AUDIENCE: must not be blank; startup fails if blank or unsafe placeholder
OAUTH2_EXPECTED_AUDIENCE=sfdc-integrator-prod

# Vault service base URL — non-secret endpoint for future vault integration
VAULT_BASE_URL=https://vault.prod.example.internal:8200

# Internal package manager — set from CI secrets, not from this file
OPSERA_REPO_URL=https://pkg.example.internal/repository/maven-opsera/
OPSERA_REPO_USER=ci-service-account
# OPSERA_REPO_TOKEN must be injected from secrets — never stored in this file
OPSERA_REPO_TOKEN=placeholder-token-not-real
