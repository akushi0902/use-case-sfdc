# test.env.example
# Placeholder fixture values for test-k8.sh dry-run and validation.
# ALL values here are non-functional placeholders only.
# Do NOT replace these with real credentials, real cluster names, or real URLs.
# Real values must be injected from your CI secret store or shell environment.

# Container image tag for the test deployment (explicit release tag required — no 'latest')
IMAGE_TAG=0.0.1-SNAPSHOT

# Test datasource — placeholder JDBC URL format only
DB_URL=jdbc:postgresql://db.test.example.internal:5432/sfdc_integrator_test
DB_USER=sfdc_integrator_test
# DB_PASSWORD must be injected from secrets — never stored in this file
DB_PASSWORD=placeholder-test-password-not-real

# Kafka bootstrap servers for test
KAFKA_BOOTSTRAP_SERVERS=kafka.test.example.internal:9092

# Kubernetes namespace (matches hardcoded NAMESPACE in test-k8.sh)
NAMESPACE=sfdc-integrator-test

# OAuth2 identity provider settings for test API pod
# Non-secret public endpoints — set at least one for JWT validation
OAUTH2_JWK_SET_URI=https://auth.test.example.internal/.well-known/jwks.json
# OAUTH2_EXPECTED_AUDIENCE: identifies this service; must not be blank in test environment
OAUTH2_EXPECTED_AUDIENCE=sfdc-integrator-test

# Vault service base URL — non-secret endpoint for future vault integration
VAULT_BASE_URL=https://vault.test.example.internal:8200

# Internal package manager — set from CI secrets, not from this file
OPSERA_REPO_URL=https://pkg.example.internal/repository/maven-opsera/
OPSERA_REPO_USER=ci-service-account
# OPSERA_REPO_TOKEN must be injected from secrets — never stored in this file
OPSERA_REPO_TOKEN=placeholder-token-not-real
